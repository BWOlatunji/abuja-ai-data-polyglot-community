---
import "../styles/global.css";

interface Props {
  title: string;
}
const { title } = Astro.props;

const navItems = [
  { href: "/admin", label: "Dashboard" },
  { href: "/admin/members", label: "Members" },
  { href: "/admin/spotlights", label: "Spotlights" },
  { href: "/admin/articles", label: "Articles" },
  { href: "/admin/events", label: "Events" },
  { href: "/admin/projects", label: "Projects" },
  { href: "/admin/submissions", label: "Submissions" },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} | Admin · Abuja AI &amp; Data Polyglot</title>
  </head>
  <body class="flex min-h-full bg-neutral-100 font-sans text-neutral-900 dark:bg-neutral-950 dark:text-neutral-100">
    <aside class="hidden w-64 flex-shrink-0 border-r border-neutral-200 bg-white p-4 md:block dark:border-neutral-800 dark:bg-neutral-900">
      <a href="/admin" class="mb-6 block font-display text-lg font-bold text-brand-700 dark:text-brand-300">Admin</a>
      <nav class="flex flex-col gap-1" aria-label="Admin">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`rounded-md px-3 py-2 text-sm font-medium ${
                currentPath === item.href
                  ? "bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-brand-200"
                  : "text-neutral-700 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800"
              }`}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <form method="post" action="/api/admin/logout" class="mt-6">
        <button type="submit" class="w-full rounded-md border border-neutral-300 px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-100 dark:border-neutral-700 dark:text-neutral-200 dark:hover:bg-neutral-800">
          Log out
        </button>
      </form>
    </aside>

    <div class="flex-1">
      <header class="flex items-center justify-between border-b border-neutral-200 bg-white px-4 py-3 md:hidden dark:border-neutral-800 dark:bg-neutral-900">
        <a href="/admin" class="font-display font-bold text-brand-700 dark:text-brand-300">Admin</a>
        <a href="/" class="text-sm text-neutral-600 dark:text-neutral-400">View site</a>
      </header>
      <main class="mx-auto max-w-5xl p-4 sm:p-8">
        <h1 class="mb-6 font-display text-2xl font-bold">{title}</h1>
        <slot />
      </main>
    </div>
  </body>
</html>
