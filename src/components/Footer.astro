---
import { siteConfig } from "../lib/config";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Community",
    links: [
      { href: "/about", label: "About" },
      { href: "/members", label: "Members" },
      { href: "/spotlights", label: "Spotlights" },
      { href: "/join", label: "Join" },
    ],
  },
  {
    heading: "Content",
    links: [
      { href: "/blog", label: "Blog" },
      { href: "/events", label: "Events" },
      { href: "/projects", label: "Projects" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { href: "/privacy", label: "Privacy Policy" },
      { href: "/contact", label: "Contact" },
    ],
  },
];
---

<footer class="border-t border-neutral-200 bg-neutral-50 dark:border-neutral-800 dark:bg-neutral-950">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2">
        <p class="font-display text-lg font-bold text-brand-700 dark:text-brand-300">{siteConfig.name}</p>
        <p class="mt-2 max-w-sm text-sm text-neutral-600 dark:text-neutral-400">{siteConfig.description}</p>
        <div class="mt-4 flex gap-3">
          {
            siteConfig.linkedinUrl && (
              <a
                href={siteConfig.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-brand-700 hover:underline dark:text-brand-300"
              >
                LinkedIn
              </a>
            )
          }
          {
            siteConfig.whatsappUrl && (
              <a
                href={siteConfig.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-brand-700 hover:underline dark:text-brand-300"
              >
                WhatsApp
              </a>
            )
          }
          {
            siteConfig.githubUrl && (
              <a
                href={siteConfig.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-brand-700 hover:underline dark:text-brand-300"
              >
                GitHub
              </a>
            )
          }
        </div>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">{col.heading}</p>
            <ul class="mt-3 space-y-2">
              {col.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-neutral-600 hover:text-brand-700 dark:text-neutral-400 dark:hover:text-brand-300">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-neutral-200 pt-6 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between dark:border-neutral-800">
      <p>&copy; {year} {siteConfig.name}. All rights reserved.</p>
      <p>
        Contact: <a href={`mailto:${siteConfig.contactEmail}`} class="hover:text-brand-700 dark:hover:text-brand-300">{siteConfig.contactEmail}</a>
      </p>
    </div>
  </div>
</footer>
