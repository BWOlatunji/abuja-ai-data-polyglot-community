---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-neutral-300 px-6 py-16 text-center dark:border-neutral-700">
  <p class="text-lg font-semibold text-neutral-800 dark:text-neutral-100">{title}</p>
  {description && <p class="max-w-md text-sm text-neutral-600 dark:text-neutral-400">{description}</p>}
  <slot />
</div>
