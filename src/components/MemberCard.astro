---
import { initials } from "../lib/utils";

interface Props {
  member: {
    display_name: string;
    slug: string;
    professional_headline: string | null;
    profile_image_url?: string | null;
    skills?: string[];
    location?: string | null;
  };
}
const { member } = Astro.props;
---

<a href={`/members/${member.slug}`} class="card flex flex-col gap-3 focus-visible:outline-none">
  <div class="flex items-center gap-3">
    {
      member.profile_image_url ? (
        <img src={member.profile_image_url} alt="" class="h-14 w-14 rounded-full object-cover" loading="lazy" />
      ) : (
        <span
          class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-100 text-lg font-semibold text-brand-700 dark:bg-brand-900/50 dark:text-brand-200"
          aria-hidden="true"
        >
          {initials(member.display_name)}
        </span>
      )
    }
    <div>
      <p class="font-semibold text-neutral-900 dark:text-neutral-100">{member.display_name}</p>
      {member.professional_headline && <p class="text-sm text-neutral-600 dark:text-neutral-400">{member.professional_headline}</p>}
      {member.location && <p class="text-xs text-neutral-500">{member.location}</p>}
    </div>
  </div>
  {
    member.skills && member.skills.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {member.skills.slice(0, 4).map((skill) => (
          <span class="badge">{skill}</span>
        ))}
      </div>
    )
  }
</a>
