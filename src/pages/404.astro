---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:px-6">
    <p class="font-display text-6xl font-bold text-brand-600">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-neutral-900 dark:text-neutral-100">We can't find that page</h1>
    <p class="mt-2 text-neutral-600 dark:text-neutral-400">
      The page you're looking for may have moved, been unpublished, or never existed.
    </p>
    <div class="mt-6 flex gap-3">
      <a href="/" class="btn-primary">Go home</a>
      <a href="/members" class="btn-secondary">Browse members</a>
    </div>
  </div>
</BaseLayout>
