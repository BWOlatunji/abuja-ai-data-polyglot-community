---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import EventCard from "../../components/EventCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import SampleDataNotice from "../../components/SampleDataNotice.astro";
import { listEvents } from "../../lib/data/events";

const { upcoming, past, isSample } = await listEvents();
---

<BaseLayout title="Events & Webinars" description="Upcoming and past community webinars, workshops, and meetups, shown in West Africa Time (WAT).">
  <Section title="Upcoming events" description="All times shown in West Africa Time (WAT).">
    {isSample && <SampleDataNotice />}
    {upcoming.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {upcoming.map((event) => <EventCard event={event} />)}
      </div>
    ) : (
      <EmptyState title="No upcoming events scheduled" description="Check back soon, or join our channels to hear about the next one." />
    )}
  </Section>

  <Section title="Past events" class="bg-neutral-50 dark:bg-neutral-950/40">
    {past.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {past.map((event) => <EventCard event={event} />)}
      </div>
    ) : (
      <p class="text-neutral-600 dark:text-neutral-400">No past events yet.</p>
    )}
  </Section>
</BaseLayout>
