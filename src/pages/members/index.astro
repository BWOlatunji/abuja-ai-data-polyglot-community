---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import MemberCard from "../../components/MemberCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import SampleDataNotice from "../../components/SampleDataNotice.astro";
import { listPublicMembers } from "../../lib/data/members";
import { listSkills, listActiveGroups } from "../../lib/data/taxonomy";

const url = Astro.url;
const search = url.searchParams.get("q") ?? "";
const skillSlug = url.searchParams.get("skill") ?? "";
const groupSlug = url.searchParams.get("group") ?? "";
const experienceLevel = url.searchParams.get("level") ?? "";

const { members, isSample } = await listPublicMembers({
  search: search || undefined,
  skillSlugs: skillSlug ? [skillSlug] : undefined,
  groupSlugs: groupSlug ? [groupSlug] : undefined,
  experienceLevel: experienceLevel || undefined,
});

const skills = await listSkills();
const groups = await listActiveGroups();

const experienceLevels = ["student", "beginner", "intermediate", "advanced", "expert"];
---

<BaseLayout title="Members" description="Search and filter the Abuja AI and Data Polyglot Community member directory.">
  <Section title="Member directory" description="Discover members by skills, interests, and experience level. Only members who have opted in and been approved for public listing appear here.">
    {isSample && <SampleDataNotice />}

    <form method="get" class="mb-8 grid gap-4 rounded-xl border border-neutral-200 bg-white p-5 sm:grid-cols-4 dark:border-neutral-800 dark:bg-neutral-900">
      <div class="sm:col-span-2">
        <label class="label-text" for="q">Search</label>
        <input id="q" name="q" class="input-field" placeholder="Name, headline, or skill" value={search} />
      </div>
      <div>
        <label class="label-text" for="skill">Technology / skill</label>
        <select id="skill" name="skill" class="input-field">
          <option value="">All skills</option>
          {skills.map((s) => (
            <option value={s.slug} selected={s.slug === skillSlug}>{s.name}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="label-text" for="group">Learning group</label>
        <select id="group" name="group" class="input-field">
          <option value="">All groups</option>
          {groups.map((g) => (
            <option value={g.slug} selected={g.slug === groupSlug}>{g.name}</option>
          ))}
        </select>
      </div>
      <div>
        <label class="label-text" for="level">Experience level</label>
        <select id="level" name="level" class="input-field">
          <option value="">Any level</option>
          {experienceLevels.map((lvl) => (
            <option value={lvl} selected={lvl === experienceLevel}>{lvl}</option>
          ))}
        </select>
      </div>
      <div class="flex items-end gap-2">
        <button type="submit" class="btn-primary">Apply filters</button>
        <a href="/members" class="btn-secondary">Reset</a>
      </div>
    </form>

    {members.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((member) => <MemberCard member={member} />)}
      </div>
    ) : (
      <EmptyState title="No members match these filters" description="Try broadening your search or clearing filters.">
        <a href="/members" class="btn-secondary mt-2">Clear filters</a>
      </EmptyState>
    )}
  </Section>
</BaseLayout>
