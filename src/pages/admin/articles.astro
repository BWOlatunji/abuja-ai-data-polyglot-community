---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import { formatDate } from "../../lib/utils";

const supabase = Astro.locals.supabase;
const editId = Astro.url.searchParams.get("edit");

const { data: articles, error } = await supabase
  .from("articles")
  .select("id, title, slug, excerpt, content, category, tags, cover_image_url, publication_status, created_at")
  .order("created_at", { ascending: false });

const editing = editId ? articles?.find((a) => a.id === editId) ?? null : null;
const success = Astro.url.searchParams.get("success");
const errorParam = Astro.url.searchParams.get("error");
---

<AdminLayout title="Articles">
  {success && <p class="mb-4 rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">Saved.</p>}
  {errorParam && <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">Could not save that article.</p>}
  {error && <p class="mb-4 text-sm text-red-700">{error.message}</p>}

  <div class="mb-10 rounded-xl border border-neutral-200 bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
    <h2 class="mb-4 font-semibold">{editing ? "Edit article" : "New article"}</h2>
    <form method="post" action="/api/admin/articles/upsert" class="grid gap-4 sm:grid-cols-2">
      {editing && <input type="hidden" name="id" value={editing.id} />}
      <div class="sm:col-span-2">
        <label class="label-text" for="title">Title</label>
        <input id="title" name="title" class="input-field" required value={editing?.title ?? ""} />
      </div>
      <div>
        <label class="label-text" for="category">Category</label>
        <input id="category" name="category" class="input-field" value={editing?.category ?? "tutorial"} />
      </div>
      <div>
        <label class="label-text" for="tags">Tags (comma separated)</label>
        <input id="tags" name="tags" class="input-field" value={(editing?.tags ?? []).join(", ")} />
      </div>
      <div class="sm:col-span-2">
        <label class="label-text" for="excerpt">Excerpt</label>
        <input id="excerpt" name="excerpt" class="input-field" value={editing?.excerpt ?? ""} />
      </div>
      <div class="sm:col-span-2">
        <label class="label-text" for="cover_image_url">Cover image URL (optional)</label>
        <input id="cover_image_url" name="cover_image_url" class="input-field" value={editing?.cover_image_url ?? ""} />
      </div>
      <div class="sm:col-span-2">
        <label class="label-text" for="content">Content (Markdown)</label>
        <textarea id="content" name="content" rows="10" class="input-field" required>{editing?.content ?? ""}</textarea>
      </div>
      <div>
        <label class="label-text" for="publication_status">Status</label>
        <select id="publication_status" name="publication_status" class="input-field">
          {["draft", "pending_review", "published", "archived"].map((s) => (
            <option value={s} selected={s === (editing?.publication_status ?? "draft")}>{s}</option>
          ))}
        </select>
      </div>
      <div class="sm:col-span-2 flex gap-2">
        <button type="submit" class="btn-primary">{editing ? "Save changes" : "Create article"}</button>
        {editing && <a href="/admin/articles" class="btn-secondary">Cancel</a>}
      </div>
    </form>
  </div>

  <div class="overflow-x-auto rounded-xl border border-neutral-200 dark:border-neutral-800">
    <table class="min-w-full divide-y divide-neutral-200 text-sm dark:divide-neutral-800">
      <thead class="bg-neutral-50 dark:bg-neutral-900">
        <tr>
          <th class="px-4 py-3 text-left font-semibold">Title</th>
          <th class="px-4 py-3 text-left font-semibold">Status</th>
          <th class="px-4 py-3 text-left font-semibold">Created</th>
          <th class="px-4 py-3 text-left font-semibold">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
        {
          (articles ?? []).map((a) => (
            <tr>
              <td class="px-4 py-3">{a.title}</td>
              <td class="px-4 py-3 capitalize">{a.publication_status.replace("_", " ")}</td>
              <td class="px-4 py-3 text-neutral-500">{formatDate(a.created_at)}</td>
              <td class="px-4 py-3">
                <div class="flex gap-2">
                  <a href={`/admin/articles?edit=${a.id}`} class="btn-secondary px-2 py-1 text-xs">Edit</a>
                  {a.publication_status === "published" && <a href={`/blog/${a.slug}`} class="btn-secondary px-2 py-1 text-xs">View</a>}
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  {(!articles || articles.length === 0) && <p class="mt-6 text-neutral-500">No articles yet.</p>}
</AdminLayout>
