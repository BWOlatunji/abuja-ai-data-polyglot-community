---
export const prerender = false;
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../lib/config";

const success = Astro.url.searchParams.get("success");
const errorParam = Astro.url.searchParams.get("error");

const errorMessages: Record<string, string> = {
  validation: "Please check the form and try again.",
  rate_limited: "Too many messages from this device recently. Please try again later.",
  bot_check_failed: "We could not verify this submission. Please try again.",
  server_error: "Something went wrong on our end. Please try again shortly.",
  not_configured: "This form is not available yet - the site's database connection has not been configured.",
};
---

<BaseLayout title="Contact" description={`Get in touch with ${siteConfig.name}.`}>
  <div class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-3xl font-bold text-neutral-900 dark:text-neutral-100">Contact us</h1>
    <p class="mt-3 text-neutral-600 dark:text-neutral-400">
      Questions, partnership enquiries, or feedback — reach out below, or via
      <a href={`mailto:${siteConfig.contactEmail}`} class="text-brand-700 hover:underline dark:text-brand-300">{siteConfig.contactEmail}</a>.
    </p>

    <div class="mt-4 flex flex-wrap gap-3">
      {siteConfig.linkedinUrl && <a href={siteConfig.linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">LinkedIn</a>}
      {siteConfig.whatsappUrl && <a href={siteConfig.whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">WhatsApp</a>}
    </div>

    {success && (
      <p class="mt-6 rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">
        Thank you — your message has been sent. We'll get back to you as soon as we can.
      </p>
    )}
    {errorParam && !success && (
      <p class="mt-6 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">
        {errorMessages[errorParam] ?? "Something went wrong. Please try again."}
      </p>
    )}

    {!success && (
      <form method="post" action="/api/contact" class="mt-8 grid gap-4">
        <div class="hidden" aria-hidden="true">
          <label for="website">Leave this field blank</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div>
          <label class="label-text" for="name">Name *</label>
          <input id="name" name="name" required class="input-field" />
        </div>
        <div>
          <label class="label-text" for="email">Email *</label>
          <input id="email" name="email" type="email" required class="input-field" />
        </div>
        <div>
          <label class="label-text" for="subject">Subject *</label>
          <input id="subject" name="subject" required class="input-field" />
        </div>
        <div>
          <label class="label-text" for="message">Message *</label>
          <textarea id="message" name="message" rows="5" required minlength="10" class="input-field"></textarea>
        </div>
        <button type="submit" class="btn-primary">Send message</button>
      </form>
    )}
  </div>
</BaseLayout>
