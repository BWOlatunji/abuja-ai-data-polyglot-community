---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import SpotlightCard from "../../components/SpotlightCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import SampleDataNotice from "../../components/SampleDataNotice.astro";
import { listPublishedSpotlights } from "../../lib/data/spotlights";

const categories = [
  { value: "", label: "All" },
  { value: "job", label: "New jobs & promotions" },
  { value: "certification", label: "Certifications" },
  { value: "award", label: "Awards & grants" },
  { value: "talk", label: "Talks & publications" },
  { value: "open_source", label: "Open source" },
  { value: "project", label: "Projects & launches" },
  { value: "volunteering", label: "Volunteering & mentoring" },
  { value: "learning_journey", label: "Learning journeys" },
];

const activeCategory = Astro.url.searchParams.get("category") ?? "";
const { spotlights, isSample } = await listPublishedSpotlights(activeCategory || undefined);

const success = Astro.url.searchParams.get("success");
const errorParam = Astro.url.searchParams.get("error");
const message = Astro.url.searchParams.get("message");
---

<BaseLayout title="Member Spotlights" description="Celebrating new jobs, certifications, awards, talks, projects, and learning journeys from the community.">
  <Section title="Member Spotlights" description="Celebrating achievements, contributions, and milestones from across the community.">
    {isSample && <SampleDataNotice />}

    <div class="mb-6 flex flex-wrap gap-2">
      {categories.map((c) => (
        <a
          href={c.value ? `/spotlights?category=${c.value}` : "/spotlights"}
          class={`badge ${activeCategory === c.value ? "bg-brand-600 text-white" : ""}`}
        >
          {c.label}
        </a>
      ))}
    </div>

    {spotlights.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {spotlights.map((s) => <SpotlightCard spotlight={s} />)}
      </div>
    ) : (
      <EmptyState title="No spotlights in this category yet" description="Check back soon, or nominate someone below." />
    )}
  </Section>

  <Section title="Nominate a spotlight" description="Nominate yourself or another member. Submissions are reviewed by an organiser before publication, and we only publish with the nominee's consent.">
    <div id="nominate" class="max-w-2xl rounded-xl border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900">
      {success && <p class="mb-4 rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200">Thank you! Your nomination has been submitted for review.</p>}
      {errorParam === "validation" && <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">{message || "Please check the form and try again."}</p>}
      {errorParam === "rate_limited" && <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">Too many submissions from this device recently. Please try again later.</p>}
      {errorParam === "server_error" && <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">Something went wrong. Please try again.</p>}
      {errorParam === "not_configured" && <p class="mb-4 rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-200">Nominations are not available yet - the site's database connection has not been configured.</p>}

      <form method="post" action="/api/spotlight-nomination" class="grid gap-4 sm:grid-cols-2">
        <div class="hidden" aria-hidden="true">
          <label for="website">Leave this field blank</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div>
          <label class="label-text" for="nominatorName">Your name</label>
          <input id="nominatorName" name="nominatorName" required class="input-field" />
        </div>
        <div>
          <label class="label-text" for="nominatorEmail">Your email</label>
          <input id="nominatorEmail" name="nominatorEmail" type="email" required class="input-field" />
        </div>
        <div class="sm:col-span-2 flex items-center gap-2">
          <input id="isSelfNomination" name="isSelfNomination" type="checkbox" />
          <label for="isSelfNomination" class="text-sm">This is a self-nomination</label>
        </div>
        <div>
          <label class="label-text" for="nomineeName">Nominee's name</label>
          <input id="nomineeName" name="nomineeName" required class="input-field" />
        </div>
        <div>
          <label class="label-text" for="nomineeEmail">Nominee's email (optional)</label>
          <input id="nomineeEmail" name="nomineeEmail" type="email" class="input-field" />
        </div>
        <div>
          <label class="label-text" for="achievementType">Achievement type</label>
          <select id="achievementType" name="achievementType" class="input-field" required>
            {categories.filter((c) => c.value).map((c) => <option value={c.value}>{c.label}</option>)}
          </select>
        </div>
        <div>
          <label class="label-text" for="achievementDate">Date (optional)</label>
          <input id="achievementDate" name="achievementDate" type="date" class="input-field" />
        </div>
        <div class="sm:col-span-2">
          <label class="label-text" for="title">Title</label>
          <input id="title" name="title" required class="input-field" placeholder="e.g. Promoted to Senior Data Analyst" />
        </div>
        <div class="sm:col-span-2">
          <label class="label-text" for="description">Tell us about it</label>
          <textarea id="description" name="description" rows="4" required class="input-field"></textarea>
        </div>
        <div class="sm:col-span-2">
          <label class="label-text" for="evidenceUrl">Supporting link (optional)</label>
          <input id="evidenceUrl" name="evidenceUrl" type="url" class="input-field" placeholder="https://..." />
        </div>
        <div class="sm:col-span-2 flex items-start gap-2">
          <input id="consentToPublish" name="consentToPublish" type="checkbox" required class="mt-1" />
          <label for="consentToPublish" class="text-sm">
            I confirm the nominee has agreed to this achievement being considered for public publication.
          </label>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="btn-primary">Submit nomination</button>
        </div>
      </form>
    </div>
  </Section>
</BaseLayout>
