---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import SampleDataNotice from "../../components/SampleDataNotice.astro";
import { getArticleBySlug, listRelatedArticles } from "../../lib/data/articles";
import { renderMarkdown } from "../../lib/markdown";
import { formatDate } from "../../lib/utils";

const { slug } = Astro.params;
const { article, isSample } = await getArticleBySlug(slug!);

if (!article) return Astro.redirect("/404");

const contentHtml = renderMarkdown(article.content);
const related = isSample ? [] : await listRelatedArticles(article.category, article.slug);
---

<BaseLayout
  title={article.title}
  description={article.excerpt ?? article.title}
  type="article"
  image={article.cover_image_url ?? undefined}
  publishedTime={article.published_at}
>
  <article class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    {isSample && <SampleDataNotice />}
    <span class="badge capitalize">{article.category.replace("-", " ")}</span>
    <h1 class="mt-3 font-display text-3xl font-bold text-neutral-900 sm:text-4xl dark:text-neutral-100">{article.title}</h1>
    <p class="mt-3 text-sm text-neutral-500">{formatDate(article.published_at)}</p>

    {article.cover_image_url && <img src={article.cover_image_url} alt="" class="mt-6 w-full rounded-xl object-cover" />}

    <div class="prose prose-neutral mt-8 max-w-none dark:prose-invert" set:html={contentHtml} />

    {article.tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-2">
        {article.tags.map((tag) => <span class="badge">#{tag}</span>)}
      </div>
    )}

    <div class="mt-10 border-t border-neutral-200 pt-6 dark:border-neutral-800">
      <ShareButtons path={`/blog/${article.slug}`} title={article.title} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6">
      <h2 class="mb-4 font-display text-xl font-bold">Related articles</h2>
      <div class="grid gap-5 sm:grid-cols-3">
        {related.map((a) => <ArticleCard article={a} />)}
      </div>
    </section>
  )}
</BaseLayout>
