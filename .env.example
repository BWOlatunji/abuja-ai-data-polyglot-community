# ------------------------------------------------------------------
# Supabase project settings
# Find these in Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------------

# Public (safe for browser) - the anon key is restricted by Row Level Security
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# PRIVATE - server-side only. Never expose in client code, logs, or commits.
# Used by Astro server endpoints (src/pages/api/**) to bypass RLS for
# administrative actions that have already been authorised server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------
# Site configuration
# ------------------------------------------------------------------
PUBLIC_SITE_URL=https://abuja-ai-data-polyglot.netlify.app
PUBLIC_COMMUNITY_NAME="Abuja AI and Data Polyglot Community"
PUBLIC_CONTACT_EMAIL=hello@example.com
PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-linkedin-handle
PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/your-invite-code
PUBLIC_GITHUB_URL=https://github.com/your-org

# ------------------------------------------------------------------
# Spam protection (optional but recommended for /join, /contact)
# Cloudflare Turnstile keys - leave blank to disable in local dev
# ------------------------------------------------------------------
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------
# Optional privacy-respecting analytics (e.g. Plausible). Leave blank to
# ship with no analytics/tracking at all.
# ------------------------------------------------------------------
PUBLIC_PLAUSIBLE_DOMAIN=
